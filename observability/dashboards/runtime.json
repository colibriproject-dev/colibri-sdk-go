    {
      "id": 7,
      "type": "timeseries",
      "title": "Memory used by type",
      "description": "Memory used by the Go runtime, by type, against the heap goal and the memory limit.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (instance, go_memory_type) (go_memory_used_bytes{job=~\"$job\", instance=~\"$instance\"})",
          "legendFormat": "{{instance}} {{go_memory_type}}",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (instance) (go_memory_gc_goal_bytes{job=~\"$job\", instance=~\"$instance\"})",
          "legendFormat": "{{instance}} gc goal",
          "range": true
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (instance) (go_memory_limit_bytes{job=~\"$job\", instance=~\"$instance\"}) < 1e15",
          "legendFormat": "{{instance}} limit",
          "range": true
        }
      ]
    },
