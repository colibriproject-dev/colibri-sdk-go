      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (topic) (rate(messaging_published_total{job=~\"$job\", instance=~\"$instance\", topic=~\"$topic\", result=\"error\"}[$__rate_interval])) / sum by (topic) (rate(messaging_published_total{job=~\"$job\", instance=~\"$instance\", topic=~\"$topic\"}[$__rate_interval]))",
          "legendFormat": "{{topic}}",
          "range": true
