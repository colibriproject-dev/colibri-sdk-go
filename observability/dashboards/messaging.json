      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (topic, result) (rate(messaging_published_total{job=~\"$job\", instance=~\"$instance\", topic=~\"$topic\"}[$__rate_interval]))",
          "legendFormat": "{{topic}} {{result}}",
          "range": true
        }
      ]
    },
